rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: read own data, write only through backend
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Backend-only writes
    }

    // Family members: read if in same family
    match /families/{familyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Care plans: read own
    match /careplans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Pharmacist dashboard: pharmacist role only
    match /pharmacist/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.role == 'pharmacist';
    }

    // Allow all authenticated users to read public data
    match /plants/{plantId} {
      allow read: if true;
    }

    match /vouchers/{voucherId} {
      allow read: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
